# --- CONFIGURACIÓN DE PRODUCCIÓN / PRODUCTION CONFIGURATION ---
# IMPORTANTE: Cambia estas variables antes de desplegar en un servidor público.
# IMPORTANT: Change these variables before deploying to a public server.
# ----------------------------------------------------------------------
DOMAIN=localhost
SSL_EMAIL=admin@${DOMAIN}
CONTACT_TO_EMAIL=admin@${DOMAIN}

# Configuración de Seguridad WAF / WAF Security Configuration
# ----------------------------------------------------------------------
# PARANOIA: Nivel de agresividad del WAF (0-4). 0 es el estándar para evitar bloqueos en WordPress.
# PARANOIA: WAF aggressiveness level (0-4). 0 is the standard to avoid WordPress blocks.
PARANOIA=0

# Configuración de MySQL / MySQL Configuration
# ----------------------------------------------------------------------
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=DockerSAMPP

# Configuración de MAILTRAP SMTP - Producción / MAILTRAP SMTP Config - Production
# ----------------------------------------------------------------------
PUBLIC_MAILTRAP_HOST=live.smtp.mailtrap.io
PUBLIC_MAILTRAP_USER=smtp@mailtrap.io
PUBLIC_MAILTRAP_PASS=***
PUBLIC_MAILTRAP_PORT=587
PUBLIC_CONTACT_FROM_EMAIL=noreply@${DOMAIN}
PUBLIC_CONTACT_TO_EMAIL=${CONTACT_TO_EMAIL}

# Configuración de PHP / PHP Configuration
# ----------------------------------------------------------------------
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=1024M
PHP_POST_MAX_SIZE=1024M
PHP_MAX_EXECUTION_TIME=300

# Configuración de MAILTRAP SMTP - Desarrollo / MAILTRAP SMTP Config - Development
# ----------------------------------------------------------------------
#PUBLIC_MAILTRAP_HOST=sandbox.smtp.mailtrap.io
#PUBLIC_MAILTRAP_USER=***
#PUBLIC_MAILTRAP_PASS=***
